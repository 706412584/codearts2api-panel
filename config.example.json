{
  "listen": ":7866",
  "api_key": "",
  "admin_key": "",
  "auth_dir": "./auths",
  "state_file": "./data/state.json",
  "default_model": "glm-5.2",
  "image_handling": "analyze",
  "max_body_mb": 32,
  "image_shrink": {
    "enabled": true,
    "trigger_body_mb": 4,
    "target_image_mb": 2,
    "target_total_mb": 4,
    "max_dimension": 2048,
    "quality": 85
  },
  "oauth_callback_host": "",
  "login_client_id": "codearts-agent",
  "cooldown": {
    "soft_rate": "60s",
    "err_threshold": 3,
    "err_cooldown": "10m"
  },
  "max_concurrent": 2,
  "keepalive_window": "10m",
  "model_refresh_minutes": 60,
  "queue_retry_seconds": 10,
  "queue_max_attempts": 30,
  "credits_auto_claim": true,
  "checkin_hours": [
    9,
    21
  ],
  "request_log_retention_days": 30,
  "watch": {
    "enabled": true,
    "poll_minutes": 30,
    "refresh_skew_minutes": 30,
    "keepalive_interval_minutes": 15
  },
  "upstream": {
    "timeout_seconds": 120
  }
}